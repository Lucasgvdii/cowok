# Copiá a .env y completá. .env está en .gitignore, no lo commitees.
POSTGRES_PASSWORD=cambiame
BASE_URL=http://localhost:8000
WM_IMAGE=ghcr.io/windmill-labs/windmill:main

# Imagen del contenedor donde corre el agente. Construila con:
#   docker build -t factory-runner:1 runner/
RUNNER_IMAGE=factory-runner:1

# 1 = el agente corre dentro de un contenedor aislado (recomendado).
# 0 = el agente corre directo en el worker. Más simple, sin aislamiento.
USE_DOCKER=1
AGENT_TIMEOUT_SECONDS=3600
AGENT_MEMORY=4g
AGENT_CPUS=2

# --- Secretos: NO van acá. Se cargan en Windmill como Variables secretas ---
# u/admin/anthropic_api_key   -> solo lo ve el paso del agente
# u/admin/github_read_token   -> solo lo ve el paso de clone
# u/admin/github_write_token  -> solo lo ve el paso de abrir PR
